# Server
PORT=5000
NODE_ENV=development

# Frontend URL(s) for CORS — comma-separated (Vercel URL after deploy)
CLIENT_URL=http://localhost:3000,http://127.0.0.1:5500

# Session secret for express-session
SESSION_SECRET=replace_with_a_strong_session_secret

# JWT signing secret
JWT_SECRET=replace_with_a_strong_jwt_secret

# PostgreSQL (encode special chars in password, e.g. @ -> %40)
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/foodapp
